{
  "name": "peachytimer-api",
  "version": "1.0.0",
  "private": true,
  "description": "Peachy Timer API: speech timing rooms and their live WebSocket feed",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun run clean && bun build --target=bun --env=disable --root=src --outdir=dist src/index.ts",
    "clean": "rm -rf dist",
    "type-check": "bunx tsc --noEmit && bunx tsc -p tsconfig.test.json",
    "knip": "knip",
    "lint": "bunx biome lint .",
    "lint:fix": "bunx biome lint --write .",
    "check": "bunx biome check .",
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "test": "bunx jest",
    "test:ci": "bunx jest --ci --coverage --watchAll=false",
    "verify": "bun run type-check && bun run check && bun run knip && bun run test:ci"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0",
    "winston": "^3.17.0",
    "ws": "^8.18.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@jest/globals": "^30.1.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.1.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "jest": "^30.1.3",
    "knip": "5.64.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "typescript": "^5.8.3"
  },
  "packageManager": "bun@1.3.5",
  "engines": {
    "bun": ">=1.3.5"
  }
}
